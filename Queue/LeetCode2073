class Solution {
    public int timeRequiredToBuy(int[] tickets, int k) {
        int n=tickets.length;
        Queue<Integer> q= new LinkedList<>();
        for(int i=0;i<n;i++){
            q.add(i);
        }
        int time=0;
        while(true){
            int per= q.poll();
            tickets[per]--;
            time++;
            if(per==k && tickets[per]==0){
                return time;
            }
            if(tickets[per]>0){
                q.add(per);
            }
        }
        
    }
}